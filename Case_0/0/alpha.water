FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    atmosphere
    {
        type            inletOutlet;
        inletValue      uniform 0;
        value           uniform 0;
    }
    wall_1
    {
        type            zeroGradient;
    }
    wall_2
    {
        type            zeroGradient;
    }
    wall_3
    {
        type            zeroGradient;
    }
    wall_4
    {
        type            zeroGradient;
    }
}


// ************************************************************************* //
